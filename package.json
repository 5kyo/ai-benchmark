{
  "name": "ai-benchmark",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20", "pnpm": ">=9" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "crawl": "tsx packages/crawler/src/cli-crawl.ts",
    "prepare-scores": "tsx packages/scoring/src/cli-prepare.ts",
    "import-scores": "tsx packages/scoring/src/cli-import.ts",
    "detect-changes": "tsx packages/scoring/src/cli-detect.ts",
    "web:dev": "pnpm --filter @ai-benchmark/web dev",
    "web:build": "pnpm --filter @ai-benchmark/web build",
    "web:seed": "tsx packages/web/scripts/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "tsx": "^4.16.2",
    "@types/node": "^20.14.0"
  }
}
